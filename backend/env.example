# Server Configuration (development defaults)
# For production (e.g. Railway): set NODE_ENV=production and all required vars below.
PORT=3001
NODE_ENV=development

# MongoDB (required in production: use Atlas or Railway MongoDB)
MONGODB_URI=mongodb://localhost:27017/ai-legal-assistant

# API Configuration
API_PREFIX=/api/v1

# CORS: frontend URL. In production set to your Vercel URL (e.g. https://your-app.vercel.app)
CORS_ORIGIN=http://localhost:3000

# AI Configuration (Get from: https://aistudio.google.com/apikey)
GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# JWT (required in production; must be at least 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Optional: OpenAI (alternative to Gemini)
# OPENAI_API_KEY=your-openai-api-key-here

