# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=123456:your-telegram-bot-token

# Base URL of the existing backend API (must include the /api/v1 prefix)
BACKEND_API_URL=https://your-backend.up.railway.app/api/v1

# Same MongoDB instance as the backend (used only to persist
# telegramUserId -> JWT token / active chat mappings for this bot)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/ai-legal-assistant

NODE_ENV=production

# Optional: if set, a tiny HTTP server responds 200 on this port.
# Not required for the bot to work (it uses long polling), but avoids
# Railway "no open port" warnings if you deploy it as a web service.
PORT=8080
